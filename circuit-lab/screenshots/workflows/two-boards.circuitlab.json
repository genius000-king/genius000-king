    "sender": {
      "files": {
        "main.ino": "// Virtual Wi-Fi + UDP. This board creates the access point.\nint state = 0;\nvoid setup() {\n  Serial.begin(115200);\n  WiFi.softAP(\"CircuitLab\", \"learn1234\", 6);\n  UDP.begin(4210);\n}\nvoid loop() {\n  state = !state;\n  UDP.beginPacket(\"192.168.4.255\", 4210);\n  UDP.print(state);\n  UDP.endPacket();\n  Serial.println(state);\n  delay(500);\n}\n"
      },
      "activeFile": "main.ino"
    }
  }
