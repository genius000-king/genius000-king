<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light navigation bar arrived in API 27; on 26 the bar keeps its own
         contrast rather than the app forcing an attribute that does not exist. -->
    <style name="Theme.Nawah" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_merino</item>
        <item name="android:statusBarColor">@color/brand_merino</item>
        <item name="android:navigationBarColor">@color/brand_merino</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
